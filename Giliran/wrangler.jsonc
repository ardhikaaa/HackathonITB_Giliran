{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "base44-tanstack-app",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "giliran-db",
      "database_id": "local-giliran-db"
    }
  ]
}
